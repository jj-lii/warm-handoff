# Copy to .env and fill in. Never commit .env. Server-side only; no NEXT_PUBLIC_ prefix.
# Variables follow docs/decisions/0012-poc-denial-check-api.md. Synthetic data only.

# TypeSafe (Jev) API key
TYPESAFE_API_KEY=

# Demo passcode for the UI (checked in middleware, issues a signed httpOnly cookie)
DEMO_PASSCODE=

# Secret used to sign the session cookie (random, 32+ chars)
SESSION_SECRET=

# Bearer token for calling /api/v1/* directly
API_BEARER_TOKEN=

# Upstash Redis (free tier) for rate limits and the daily cap; leave empty locally for the in-memory fallback
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Gemini (eval data generation only; never called by the app)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Anthropic (thin appeal-drafting layer)
ANTHROPIC_API_KEY=
