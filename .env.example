# Copy to .env and fill in. Never commit .env. Server-side only; no NEXT_PUBLIC_ prefix.
# The app is open with spend caps (docs/decisions/0019-open-demo-with-spend-caps.md). Synthetic data only.
# Without keys the app still runs and serves its pre-generated results.

# --- App (set these in Vercel too) ---

# TypeSafe (Jev) API key: live triage
TYPESAFE_API_KEY=
# Optional; defaults to jev-latest
JEV_MODEL=

# Anthropic: checked appeal drafts
ANTHROPIC_API_KEY=
# Optional; defaults to claude-haiku-4-5
DRAFT_MODEL=

# Upstash Redis (free tier): per-IP limits and daily caps shared across instances.
# Leave empty locally for the in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Evals only (never called by the app) ---

# Gemini: synthetic letter generation and the Flash-Lite baseline
GEMINI_API_KEY=
GEMINI_MODEL=
